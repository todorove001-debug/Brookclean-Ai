# Контент-фабрика Brookclean — переменные окружения.
# Скопируйте в .env и заполните. Файл .env не коммитится и должен быть доступен только администратору (chmod 600).

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- База данных (docker-compose подставляет DATABASE_URL сам, нужен только пароль) ---
DB_PASSWORD=смените-на-длинный-случайный-пароль
# DATABASE_URL=postgresql+asyncpg://factory:<пароль>@db:5432/factory

# Публичный адрес API (HTTPS через обратный прокси). Нужен для ссылок /r/<код> и вебхука Telegram.
PUBLIC_BASE_URL=https://factory.example.ru
API_BIND=127.0.0.1
API_PORT=8000

# --- Хранилище медиа: s3 (Reg.ru, Yandex Object Storage, MinIO) или local ---
STORAGE_BACKEND=s3
S3_ENDPOINT=https://s3.regru.cloud
S3_REGION=ru-1
S3_BUCKET=brookclean-content
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BACKUP_PREFIX=backups/
MAX_UPLOAD_MB=1024

# --- Языковая модель (общая для всех агентов) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
SEARCH_PROVIDERS=anthropic_web,rss

# --- Изображения: openai | none ---
IMAGE_PROVIDER=none
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2

# --- ИИ-видео: openai_sora | runway | none ---
VIDEO_PROVIDER=none
# для openai_sora: sora-2 или sora-2-pro; для runway: gen4.5
VIDEO_MODEL=sora-2
RUNWAY_API_KEY=
VIDEO_POLL_INTERVAL_S=20
VIDEO_MAX_WAIT_MINUTES=90

# --- Распознавание речи для субтитров: openai | none ---
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_MODEL=whisper-1

# --- Проверка орфографии (Яндекс.Спеллер) ---
SPELLER_ENABLED=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# @username канала или числовой ID (-100...). Бот должен быть администратором канала с правом публикации.
TELEGRAM_CHANNEL_ID=@Brookcleantrucks
# polling — отдельный процесс bot; webhook — обновления принимает API (нужен HTTPS и секрет)
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAX_UPLOAD_MB=50
# Числовые Telegram user ID владельца и администраторов (узнать: @userinfobot). Через запятую.
BOOTSTRAP_OWNER_TELEGRAM_IDS=
BOOTSTRAP_ADMIN_TELEGRAM_IDS=

# --- Просмотры через MTProto (необязательно, нужен pip install '.[mtproto]') ---
MTPROTO_API_ID=
MTPROTO_API_HASH=
MTPROTO_SESSION_PATH=

# --- Исходящие запросы к API поставщиков через прокси (если нужен) ---
OUTBOUND_PROXY_URL=

# --- Мониторинг ---
SENTRY_DSN=
# Если задан, /metrics требует заголовок Authorization: Bearer <токен>
METRICS_TOKEN=

WORKER_CONCURRENCY=2
