# База данных PostgreSQL
DATABASE_URL=postgres://brook:brook@localhost:5432/brookclean
# Хранилище фото, видео и актов: local — папка на диске, s3 — объектное хранилище Reg.ru
STORAGE=local
STORAGE_DIR=./storage
S3_ENDPOINT=https://s3.regru.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
PORT=3000
# Срок входа в днях
SESSION_DAYS=30
# Максимальный размер одного файла, МБ
MAX_UPLOAD_MB=500
# console — код подписи пишется в лог; позже smsc / smsru
SMS_PROVIDER=console
# Первый менеджер: npm run seed
SEED_PHONE=
SEED_PASSWORD=
SEED_NAME=Тодоров Евгений Константинович
# Адрес сайта для клиентов — ссылка на личный кабинет в SMS (по умолчанию https://CLIENT_DOMAIN)
CLIENT_URL=
# Перевозчик в документах
CARRIER_NAME=ИП Тодоров Евгений Константинович
CARRIER_INN=253717132973
CARRIER_PHONE=+7 950 281 55 55
