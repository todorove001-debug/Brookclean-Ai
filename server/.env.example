# База данных PostgreSQL
DATABASE_URL=postgres://brook:brook@localhost:5432/brookclean
# Папка для фото, видео и актов (позже — Yandex Object Storage / S3)
STORAGE_DIR=./storage
PORT=3000
# Срок входа в днях
SESSION_DAYS=30
# Максимальный размер одного файла, МБ
MAX_UPLOAD_MB=500
# console — код подписи пишется в лог; позже smsc / smsru
SMS_PROVIDER=console
# Первый менеджер: npm run seed
SEED_PHONE=
SEED_PASSWORD=
SEED_NAME=Тодоров Евгений Константинович
