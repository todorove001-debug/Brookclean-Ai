# Домен, A-запись которого указывает на IP сервера Reg.ru
DOMAIN=app.example.ru
# Пароль базы данных — длинный случайный: openssl rand -hex 24
DB_PASSWORD=

# Объектное хранилище S3 Reg.ru: ключи и бакет из личного кабинета
S3_ENDPOINT=https://s3.regru.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

SESSION_DAYS=30
MAX_UPLOAD_MB=500
SMS_PROVIDER=console
