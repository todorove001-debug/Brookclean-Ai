PORT=3000
# Адрес сайта для ссылок в SMS
PUBLIC_URL=https://brookclean-reg.ru
# Отдельный адрес панели сотрудников. Пока пусто — панель открывается на сайте по /admin
STAFF_URL=https://staff.brookclean-reg.ru
DB_FILE=/opt/brookclean/data/brookclean.db
ORDER_NO_START=685
# Первый владелец панели /admin (создаётся, пока сотрудников нет; потом можно убрать)
OWNER_LOGIN=
OWNER_PASSWORD=
# Необязательно: длинная строка для доступа к API панели из скриптов (Authorization: Bearer …)
ADMIN_TOKEN=
# Google Диск для рейсовых отчётов (OAuth-клиент «Веб-приложение» в Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# console — коды пишутся в лог (разработка); smsaero — боевая отправка
SMS_PROVIDER=console
SMSAERO_EMAIL=
SMSAERO_API_KEY=
# Имя отправителя, согласованное в кабинете SMS Aero (пока не согласовано — пусто)
SMSAERO_SIGN=
# Яндекс SmartCaptcha (консоль Yandex Cloud → SmartCaptcha → капча для brookclean-reg.ru).
# Показывается только при подозрительной активности; без ключей действуют только лимиты
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Распознавание фото (документы, чеки, повреждения) — Yandex AI Studio. Ключ только здесь, не в коде.
# Сервисный аккаунт с ролью ai.languageModels.user → API-ключ; каталог b1g…
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модели по порядку: следующая, если предыдущая вернула пустой ответ или не уложилась во время
YANDEX_VISION_MODELS=qwen3.6-35b-a3b/latest,deepseek-v4.1-flash/latest
YANDEX_TIMEOUT_MS=60000

# Фото и видео приёмки — объектное хранилище S3 Reg.ru (не диск сервера).
# Панель Reg.ru → Облачные сервисы → S3: бакет и ключи доступа. В бакете включите CORS: PUT и GET с https://staff.brookclean-reg.ru
S3_ENDPOINT=https://s3.regru.cloud
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Telegram: сообщение менеджеру о каждом подписанном договоре (бот через @BotFather, chat_id группы или менеджера)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
